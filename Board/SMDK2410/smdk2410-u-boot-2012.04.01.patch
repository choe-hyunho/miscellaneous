+# along with this program; if not, write to the Free Software
+# Foundation, Inc., 59 Temple Place, Suite 330, Boston,
+# MA 02111-1307 USA
+#
+#
+# Samsung S3C2410 Reference Platform (smdk2410) board
+
+# CONFIG_SYS_TEXT_BASE for SPL:
+#
+# On S3C2410 platforms the SPL is located in SRAM at 0.
+#
+# CONFIG_SYS_TEXT_BASE = 0
+
+include $(TOPDIR)/board/$(BOARDDIR)/config.mk
+
+# PAD_TO used to generate a 16kByte binary needed for the combined image
+# -> PAD_TO = CONFIG_SYS_TEXT_BASE + 16384
+PAD_TO	:= $(shell expr $$[$(CONFIG_SYS_TEXT_BASE) + 16384])
+
+ifeq ($(debug),1)
+PLATFORM_CPPFLAGS += -DDEBUG
+endif
diff -urN u-boot-2012.04.01.orig/nand_spl/board/samsung/smdk2410/Makefile u-boot-2012.04.01/nand_spl/board/samsung/smdk2410/Makefile
--- u-boot-2012.04.01.orig/nand_spl/board/samsung/smdk2410/Makefile	1970-01-01 09:00:00.000000000 +0900
+++ u-boot-2012.04.01/nand_spl/board/samsung/smdk2410/Makefile	2026-06-09 20:20:59.411881059 +0900
@@ -0,0 +1,112 @@
+#
+# (C) Copyright 2006-2007
+# Stefan Roese, DENX Software Engineering, sr@denx.de.
+#
+# (C) Copyright 2008
+# Guennadi Liakhovetki, DENX Software Engineering, <lg@denx.de>
+#
+# See file CREDITS for list of people who contributed to this
+# project.
